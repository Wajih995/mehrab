// MEHRAB — Prisma schema
// Postgres on Vercel (Neon / Vercel Postgres).
//   DATABASE_URL — pooled connection (pgbouncer) used by the app at runtime
//   DIRECT_URL   — direct connection used for migrations
// See DEPLOYMENT.md for the full Vercel + Neon setup.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth.js (Auth.js v5) ────────────────────────────────────
enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]
  orders    Order[]
  addresses Address[]
  reviews   Review[]
  wishlist  WishlistItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Catalogue ──────────────────────────────────────────────
model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  image       String
  season      String?
  createdAt   DateTime  @default(now())

  products Product[] @relation("ProductCollections")
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  /// Manual style/article code entered by staff — never auto-generated.
  articleNumber  String?  @unique
  name           String
  subtitle       String?
  description    String   @db.Text
  price          Int
  compareAtPrice Int?
  fabric         String
  season         String
  colors         Json // [{ name, hex }]
  sizes          String[]
  rating         Float    @default(5)
  reviewCount    Int      @default(0)
  badges         String[]
  inStock        Boolean  @default(true)
  isNew          Boolean  @default(false)
  isBestSeller   Boolean  @default(false)
  specifications Json? // Record<string, string>
  careInstructions String[]
  /// SEO overrides — fall back to the product name/description when unset.
  metaTitle       String?
  metaDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  images      ProductImage[]
  collections Collection[]   @relation("ProductCollections")
  reviews     Review[]
  orderItems  OrderItem[]
  wishlistIn  WishlistItem[]

  @@index([fabric])
  @@index([season])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String  @db.Text
  alt       String
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  author    String
  location  String?
  rating    Int
  title     String
  body      String   @db.Text
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ─── Orders ─────────────────────────────────────────────────
enum OrderStatus {
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  CARD
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String?
  status        OrderStatus   @default(CONFIRMED)
  paymentMethod PaymentMethod @default(COD)

  email     String
  fullName  String
  phone     String
  address   String
  city      String
  province  String
  postalCode String?
  notes     String?

  subtotal Int
  discount Int    @default(0)
  shipping Int    @default(0)
  total    Int
  couponCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  slug      String
  name      String
  image     String  @db.Text
  price     Int
  size      String
  color     String
  quantity  Int
  /// "Shalwar" or "Pajama" — the bottom garment the customer chose.
  bottomStyle String?
  /// Made-to-order measurements (inches) when size is "Custom".
  custom    Json?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  line1     String
  city      String
  province  String
  postalCode String?
  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String // percent | fixed | shipping
  value       Int
  label       String
  minSubtotal Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ─── Admin-editable site settings (delivery rates, …) ───────
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "delivery"
  data      Json
  updatedAt DateTime @updatedAt
}

// ─── Site navigation (admin-editable menus) ─────────────────
model SiteMenu {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "main-nav"
  data      Json // MegaMenuSection[] — same shape the storefront renders
  updatedAt DateTime @updatedAt
}
