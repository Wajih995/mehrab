# ─── Database (Neon / Vercel Postgres) ─────────────────────
# Pooled connection (pgbouncer) — used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/mehrab?sslmode=require"
# Direct connection — used for migrations (prisma migrate/db push).
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/mehrab?sslmode=require"

# NOTE: With no DATABASE_URL set, the app runs in DEMO mode (static catalogue +
# client stores) so local dev works with zero setup.

# ─── Auth.js (v5) ───────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# AUTH_URL is auto-detected on Vercel; set only for custom local ports.
# AUTH_URL="http://localhost:3000"

# OAuth providers (optional — adapter is ready)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Seed (optional overrides) ─────────────────────────────
SEED_ADMIN_EMAIL="admin@mehrab.pk"
SEED_ADMIN_PASSWORD="mehrab"

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://mehrabessentials.com"
NEXT_PUBLIC_SITE_NAME="MEHRAB"

# ─── Payments (Stripe-ready, optional) ─────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Email (Resend) ─────────────────────────────────────────
# With no RESEND_API_KEY set, order emails are logged to the console instead.
RESEND_API_KEY=""
# After verifying your domain in Resend: "MEHRAB <orders@yourdomain.com>"
EMAIL_FROM="MEHRAB <onboarding@resend.dev>"
# Customer replies go here — e.g. your Gmail inbox.
EMAIL_REPLY_TO=""
